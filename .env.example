# URL of your Strapi CMS (no trailing slash), e.g. http://localhost:1337
# Leave it unset to build the site with the bundled demo content.
# STRAPI_URL=http://localhost:1337

# Optional read-only API token (Strapi admin > Settings > API Tokens).
# Only needed when the Public role is not allowed to read services and blog posts.
# STRAPI_API_TOKEN=

# Optional: public URL used for canonical links and the sitemap.
# Defaults to the Vercel production domain, then to site.base_url in src/config/config.json.
# SITE_URL=https://example.com
