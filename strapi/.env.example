HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi MCP server at POST /mcp (authenticated with an Admin token).
MCP_ENABLED=true

# Give the Public role read access to services and blog posts (used by the Astro build).
PUBLIC_READ_ACCESS=true

# Admin token used by "npm run seed" (Settings > Admin tokens).
STRAPI_ADMIN_TOKEN=