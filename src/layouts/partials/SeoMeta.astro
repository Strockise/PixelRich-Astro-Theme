---
import config from '@/config/config.json';

export interface Props {
  /** Page name. Rendered as "Name || <title_suffix>", the format the template uses. */
  title?: string;
  /** Use the value as the full <title> without the suffix (CMS detail pages). */
  fullTitle?: boolean;
  description?: string | null;
  image?: string;
  /** Set for pages that should not be indexed (utility pages). */
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, fullTitle = false, description, image, noindex = false, type = 'website' } = Astro.props;
const { site, metadata } = config;

const pageTitle = !title ? `${site.title} - ${site.tagline}` : fullTitle ? title : `${title} || ${site.title_suffix}`;
const pageDescription = description || metadata.meta_description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageUrl = new URL(image || metadata.meta_image, Astro.site ?? Astro.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription}>
<meta name="author" content={metadata.meta_author}>
<link rel="canonical" href={canonical.href}>
{noindex && <meta name="robots" content="noindex, follow">}
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={pageDescription}>
<meta property="og:image" content={imageUrl}>
<meta property="og:url" content={canonical.href}>
<meta property="og:site_name" content={site.title}>
<meta property="og:type" content={type}>
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={pageDescription}>
<meta name="twitter:image" content={imageUrl}>
<meta name="twitter:card" content="summary_large_image">
