---
import Base from '@/layouts/Base.astro';
---

<Base wfPage="6ac88618bf614c70ada7f1d2" title="Not Found" noindex footer={false} wrapperClass="utility-page-wrap">
  <div class="utility-page-content">
    <div class="_404-text-block">
      <h2 class="_404-text">4<span class="_404-highlight-text">0</span>4</h2>
    </div>
    <div class="_404-title-block">
      <h2 class="_404-title">Oops! Page not found</h2>
      <div class="_404-summary">The page you are looking for doesn&#x27;t exist or has been moved</div>
    </div>
    <div class="_404-button-block">
      <a href="/" class="secondary-button w-inline-block">
        <p class="button-text">Go To Home Page</p>
      </a>
    </div>
  </div>
</Base>
